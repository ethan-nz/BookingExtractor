<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe = a Windows program with a window (no console box behind it). -->
    <OutputType>WinExe</OutputType>

    <!--
      Target framework. .NET 8 is what the original used. As far as I know its
      support ends on 10 November 2026 (confirm on Microsoft's .NET support policy
      page). To move to the current LTS, install the .NET 10 SDK, then change this
      to net10.0-windows and rebuild.
    -->
    <TargetFramework>net8.0-windows</TargetFramework>

    <UseWindowsForms>true</UseWindowsForms>

    <!-- Nullable: the compiler warns when something that might be null is used unsafely. -->
    <Nullable>enable</Nullable>

    <!-- ImplicitUsings: common "using" lines (System, System.IO, System.Linq ...) are added for you. -->
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>BookingExtractor</AssemblyName>
    <RootNamespace>BookingExtractor</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Pinned to an exact version so builds are repeatable. Check NuGet for newer
      versions when you choose to upgrade. This app connects to YOUR installed
      Chrome/Edge, so no "playwright install" browser download is needed.
    -->
    <PackageReference Include="Microsoft.Playwright" Version="1.61.0" />
  </ItemGroup>

</Project>
