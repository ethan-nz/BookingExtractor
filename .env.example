# OPTIONAL. Copy to ".env" ONLY if you want automatic login.
# If you leave these out, the app shows a login box when the site needs it, and
# keeps the password in memory only (never saved).
#
# Safer: save this file in  %LOCALAPPDATA%\BookingExtractor\.env  rather than
# inside the project folder, and never commit it to version control.
#
# Put quotes around values, and nothing after the closing quote.
HEALTH_EMAIL="you@example.com"
HEALTH_PASSWORD="your-password"

# Other optional settings (defaults shown):
# BOOKING_COLUMN="Gao"
# BOOKING_COLUMN_OFFSET=-1
# CHROME_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"
# SAVE_ERROR_SCREENSHOTS=0
